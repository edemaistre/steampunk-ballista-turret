{
  "name": "steampunk-ballista-turret",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "serve --single --listen $PORT dist",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "serve": "14.2.6",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/three": "0.185.4",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
